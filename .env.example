# Public identity (safe to expose)
NEXT_PUBLIC_STUDENT_NAME=Mihails Ozerovs
NEXT_PUBLIC_GITHUB_URL=https://github.com/mozerovs06-maker/friends-included-finance-system
NEXT_PUBLIC_TELEGRAM_BOT_URL=https://t.me/FriendsIncludedMihailsBot
NEXT_PUBLIC_GOOGLE_SHEET_URL=https://docs.google.com/spreadsheets/d/1AZ7dS-FRFeKiHYz9QUAqyW2uyw0RwPHzETsNlKlJOWs/edit

# Supabase (server-only service role key; never prefix with NEXT_PUBLIC_)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-in-local-env-or-vercel

# Manager setup and Telegram (server-only)
MANAGER_SETUP_KEY=replace-with-a-long-random-value
TELEGRAM_BOT_TOKEN=replace-in-local-env-or-vercel
TELEGRAM_WEBHOOK_SECRET=replace-with-a-long-random-value

# Google Sheets service account (server-only; JSON with escaped newlines)
GOOGLE_SHEET_ID=replace-with-spreadsheet-id
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# Optional: enable the Public Tests tab integration
ENABLE_PUBLIC_TESTS_SHEET=true
